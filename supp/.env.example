# supp/.env 템플릿 — 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 절대 커밋 금지)
# 키 이름만 기재. 값은 각자 발급.

# --- OpenRouter (supp_03 ~ supp_08 공통, base_url=https://openrouter.ai/api/v1) ---
OPENROUTER_API_KEY=
# (선택) 텍스트 LLM 덮어쓰기. 비우면 기본 google/gemma-4-26b-a4b-it (supp_08 백엔드도 사용)
OPENROUTER_MODEL=
# (선택) 비전 모델 덮어쓰기 (supp_05). 비우면 기본 google/gemma-4-26b-a4b-it
OPENROUTER_VISION_MODEL=
# (선택) supp_07 ADK 텍스트 모델 덮어쓰기. 비우면 기본 google/gemma-4-26b-a4b-it
OPENROUTER_TEXT_MODEL=

# --- Neo4j (supp_04) ---
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- (선택) supp_03 demo_helpdesk Postgres DSN ---
HELPDESK_PG_DSN=

# --- (선택) OpenAI 직접 사용 시 ---
OPENAI_API_KEY=
