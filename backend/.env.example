# PostgreSQL (insert.sql 로 시드) 예: postgresql://postgres:비밀번호@localhost:5432/postgres
POSTGRESQL_CONNECTION_STRING=
# 테이블 스키마 (insert.sql 기준 public)
DB_SCHEMA=public

# 로컬 Ollama (BASIC_BASE_URL 이 비어 있으면 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI 호환 API (OpenRouter 등) 사용 시 설정 예: https://openrouter.ai/api/v1 , openai/gpt-4o-mini
BASIC_BASE_URL=
BASIC_MODEL=
BASIC_API_KEY=

REASONING_MODEL=
REASONING_BASE_URL=
REASONING_API_KEY=
VL_MODEL=
VL_BASE_URL=
VL_API_KEY=

TAVILY_API_KEY=
JINA_API_KEY=
CHROME_INSTANCE_PATH=
