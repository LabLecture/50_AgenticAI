# PostgreSQL (insert.sql 로 시드) — 아래 둘 중 하나만 설정
# (1) 연결 문자열 예: postgresql://postgres:비밀번호@localhost:5432/postgres
POSTGRESQL_CONNECTION_STRING=
# (2) 개별 항목 (연결 문자열이 비어 있을 때 사용)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# 테이블 스키마 (insert.sql 기준 public)
DB_SCHEMA=public

# 로컬 Ollama (BASIC_BASE_URL 이 비어 있으면 사용)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI 호환 API (OpenRouter 등) 사용 시 설정 예: https://openrouter.ai/api/v1 , openai/gpt-4o-mini
BASIC_BASE_URL=
BASIC_MODEL=
BASIC_API_KEY=

REASONING_MODEL=
REASONING_BASE_URL=
REASONING_API_KEY=
VL_MODEL=
VL_BASE_URL=
VL_API_KEY=

# (선택) 웹검색
TAVILY_API_KEY=
JINA_API_KEY=
CHROME_INSTANCE_PATH=
