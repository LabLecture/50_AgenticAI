# LLM: OpenRouter Gemma 4 26B A4B (basic / reasoning / vision / supervisor 공통)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it

# PostgreSQL (insert.sql 로 시드) — 아래 둘 중 하나만 설정
# (1) 연결 문자열 예: postgresql://postgres:비밀번호@localhost:5432/postgres
POSTGRESQL_CONNECTION_STRING=
# (2) 개별 항목 (연결 문자열이 비어 있을 때 사용)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# 테이블 스키마 (insert.sql 기준 public)
DB_SCHEMA=public

# (선택) 웹검색 / 크롤링 / 브라우저
# TAVILY_API_KEY=
JINA_API_KEY=
CHROME_INSTANCE_PATH=
